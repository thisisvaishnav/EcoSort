# EcoSort Heroes - Environment Configuration

# Backend API (API Gateway + Lambda)
VITE_API_ENDPOINT=https://api.ecosort-heroes.local/v1
VITE_AWS_REGION=us-east-1

# AWS Cognito (Auth for Teachers/Students)
VITE_COGNITO_USER_POOL_ID=us-east-1_example
VITE_COGNITO_CLIENT_ID=exampleclientid

# AWS Polly Voice ID
VITE_POLLY_VOICE_ID=Justin

# Set to true for local standalone mode (mocking AWS Lambda & DynamoDB in-browser)
VITE_USE_MOCK_BACKEND=true
